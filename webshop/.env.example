# Environment Configuration Example
# คัดลอกไฟล์นี้เป็น .env และแก้ไขค่าต่างๆ ให้เหมาะสม

# Database Configuration
DB_HOST=localhost
DB_NAME=minecraft_webshop
DB_USER=root
DB_PASS=your_database_password

# RCON Configuration
RCON_HOST=localhost
RCON_PORT=25575
RCON_PASSWORD=your_rcon_password
RCON_TIMEOUT=5
RCON_MAX_CONNECTIONS=5

# JWT Configuration
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_here_at_least_32_characters

# Redis Configuration (Optional - for better performance)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Security Configuration
ENABLE_IP_WHITELIST=false
ENABLE_RATE_LIMITING=true
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=1800

# Email Configuration (for alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ADMIN_EMAIL=admin@yourserver.com

# Application Configuration
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourserver.com/webshop
SITE_NAME=Minecraft Webshop

# Logging
LOG_LEVEL=info
LOG_FILE=/var/log/webshop/app.log

# Rate Limiting
RATE_LIMIT_LOGIN=5
RATE_LIMIT_PURCHASE=10
RATE_LIMIT_DEFAULT=100

# Security Headers
ENABLE_HSTS=true
ENABLE_CSP=true
ENABLE_SECURITY_HEADERS=true

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30

